# Forex Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# Exchange API Configuration
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_key_here

# Bot Settings
BOT_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,AUD/USD
BOT_TIMEFRAME=1h
BOT_POSITION_SIZE=0.01
BOT_MAX_POSITIONS=3
BOT_STOP_LOSS_PIPS=50
BOT_TAKE_PROFIT_PIPS=100

# Risk Management
MAX_DAILY_LOSS=0.02
MAX_PORTFOLIO_RISK=0.05

# Dashboard Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=forex_bot.log